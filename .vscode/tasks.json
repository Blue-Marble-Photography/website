{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/website" },
            "command": "bundle exec jekyll serve --livereload --trace",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/website" },
            "command": "bundle exec jekyll build",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
